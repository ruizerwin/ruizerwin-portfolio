# ============================================================
# PRODUCTION server template (safe to commit)
# On the server: copy to .env (never commit the real .env)
# Path: /var/www/ruizerwin.com/.env
# ============================================================

APP_NAME=ruizerwin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ruizerwin.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=ruizerwin.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Zoho SMTP (use Laravel MAIL_* names — not ZOHO_*)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.zohocloud.ca
MAIL_PORT=465
MAIL_USERNAME=contact@ruizerwin.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@ruizerwin.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_INBOX_ADDRESS=
MAIL_INBOX_NAME="Erwin Padilla"

RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
