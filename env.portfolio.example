# ============================================================
# Portfolio contact + mail checklist (NO SECRETS)
# Copy values into each environment's real .env on the server
# or local machine. Never commit a filled .env.
# ============================================================

APP_NAME="Erwin D. Padilla"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ruizerwin.com

########################################
# ZOHO SMTP (MAIL_*)
# Canada datacenter account uses smtp.zohocloud.ca
# Port 465 + MAIL_SCHEME=smtps  (SSL)
# Or port 587 + MAIL_SCHEME=null (STARTTLS)
# MAIL_USERNAME and MAIL_FROM_ADDRESS must be the Zoho mailbox
# (or an alias on that mailbox). Use a Zoho app password.
########################################
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.zohocloud.ca
MAIL_PORT=465
MAIL_USERNAME=contact@ruizerwin.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@ruizerwin.com
MAIL_FROM_NAME="${APP_NAME}"

# Where contact-form messages are delivered
MAIL_INBOX_ADDRESS=ruizerwin1@gmail.com
MAIL_INBOX_NAME="Erwin Padilla"

# Optional legacy aliases (still supported by config/mail.php)
CONTACT_TO_EMAIL=ruizerwin1@gmail.com
CONTACT_TO_NAME="Erwin Padilla"

########################################
# GOOGLE reCAPTCHA v3
# Domains must include: localhost, ruizerwin.com.test,
# staging.ruizerwin.com, ruizerwin.com, www.ruizerwin.com
########################################
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5

# Optional legacy aliases (still supported by config/services.php)
# CONTACT_RECAPTCHA_SITE_KEY=
# CONTACT_RECAPTCHA_SECRET_KEY=
