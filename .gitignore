# ============================================================
# RUIZERWIN.COM
# Files that must NEVER be committed to GitHub
# ============================================================

# ENVIRONMENT / SECRETS
.env
.env.*
!.env.example

auth.json
credentials.json
secrets.json

# SSH / SSL / PRIVATE KEYS
*.pem
*.key
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# PHP / COMPOSER
/vendor/
/apps/web/vendor/
composer.phar
.phpunit.result.cache
.phpunit.cache/

# NODE / NPM
/node_modules/
/apps/web/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# LARAVEL (Portfolio 2.0 parallel app under apps/web)
/apps/web/storage/logs/*
/apps/web/storage/framework/cache/*
/apps/web/storage/framework/sessions/*
/apps/web/storage/framework/views/*
/apps/web/bootstrap/cache/*
!/apps/web/storage/logs/.gitignore
!/apps/web/storage/framework/cache/.gitignore
!/apps/web/storage/framework/sessions/.gitignore
!/apps/web/storage/framework/views/.gitignore
!/apps/web/bootstrap/cache/.gitignore
/apps/web/public/hot
/apps/web/public/storage

# IDE / EDITORS
.vscode/
.idea/
.cursor/
*.code-workspace

# LOCAL DEVELOPMENT / DEPLOYMENT
/tools/
*.bat
*.cmd
*.ps1

# LOGS
*.log
/logs/
/log/

# TEMP / CACHE
/tmp/
/temp/
/cache/
*.tmp
*.temp
*.cache

# DATABASE BACKUPS
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3

# BACKUPS
*.bak
*.backup
*.old
*.orig
*.save
*~
*.swp
*.swo

# OPERATING SYSTEM
.DS_Store
Thumbs.db
desktop.ini

# ARCHIVES
*.zip
*.rar
*.7z
*.tar
*.tar.gz