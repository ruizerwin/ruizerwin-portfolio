# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your REAL values in .env only
# 3. NEVER commit .env to GitHub — it is gitignored
#
# Variable names were updated (July 2026). Old names no longer work.
# If credentials were ever leaked, use NEW Zoho + reCAPTCHA values only.
# =============================================================================

# Application
APP_NAME=ruizerwin
APP_URL=https://ruizerwin.com
APP_ENV=production

# reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# Domains: ruizerwin.com, www.ruizerwin.com, staging.ruizerwin.com
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

# Zoho Mail — App-Specific Password (NOT your login password)
ZOHO_SMTP_HOST=smtp.zohocloud.ca
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=contact@ruizerwin.com
ZOHO_APP_PASSWORD=
ZOHO_SMTP_ENCRYPTION=ssl

# Outgoing mail identity
MAIL_FROM_ADDRESS=contact@ruizerwin.com
MAIL_FROM_NAME=ruizerwin

# Where contact form messages are delivered
MAIL_INBOX_ADDRESS=ruizerwin1@gmail.com
MAIL_INBOX_NAME=Erwin Padilla
