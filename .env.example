# *****************************************************************************
# ENVIRONMENT CONFIGURATION — ruizerwin.com
# *****************************************************************************
#
# HOW TO USE:
#   1. Copy:  cp .env.example .env
#   2. Edit:  nano .env
#   3. Fill in your real passwords and keys
#   4. NEVER upload .env to GitHub (it is gitignored)
#
# IMPORTANT RULES:
#   - Use ONLY # for comments (NOT /* */ — that breaks the parser!)
#   - Values with spaces MUST use quotes:  MAIL_INBOX_NAME="Erwin Padilla"
#   - No spaces around the = sign
#   - Old variable names still work (see legacy notes below)
#
# SERVER PERMISSIONS:
#   sudo chown ubuntu:www-data .env
#   chmod 640 .env
#
# *****************************************************************************


# *****************************************************************************
# APPLICATION
# *****************************************************************************

# Site name used in page titles and email sender name (if MAIL_FROM_NAME is empty)
APP_NAME=ruizerwin

# Full URL of this environment (no trailing slash)
# Production:  https://ruizerwin.com
# Staging:     https://staging.ruizerwin.com
# Local:       http://ruizerwin.com.test
# Public site URL — must use https:// (required for secure resume downloads)
APP_URL=https://ruizerwin.com

# Environment mode — controls PHP error display
# production  = hide errors from visitors (use on live server)
# local       = show errors (use on Laragon for debugging)
APP_ENV=production


# *****************************************************************************
# GOOGLE reCAPTCHA v3 (anti-spam on contact form)
# *****************************************************************************
# Get keys: https://www.google.com/recaptcha/admin
# Type: reCAPTCHA v3 (NOT v2 checkbox)
# Add these domains: ruizerwin.com, www.ruizerwin.com, staging.ruizerwin.com
#
# Public key — used in the browser (safe to expose in HTML)
RECAPTCHA_V3_SITE_KEY=

# Secret key — used on server only (NEVER share or commit)
RECAPTCHA_V3_SECRET_KEY=

# Legacy names (still supported if you prefer old format):
# CONTACT_RECAPTCHA_SITE_KEY=
# CONTACT_RECAPTCHA_SECRET_KEY=


# *****************************************************************************
# ZOHO MAIL — SMTP (sends contact form emails)
# *****************************************************************************
# Zoho Mail → Settings → Security → App Passwords
# Use an App-Specific Password — NOT your Zoho login password

# Zoho SMTP server (Canada)
ZOHO_SMTP_HOST=smtp.zohocloud.ca

# SMTP port — 465 = SSL (recommended for Zoho Canada)
ZOHO_SMTP_PORT=465

# Zoho email account used to send mail
ZOHO_SMTP_USER=contact@ruizerwin.com

# Zoho App Password (generate new if ever leaked)
ZOHO_APP_PASSWORD=

# Encryption type — ssl for port 465, tls for port 587
ZOHO_SMTP_ENCRYPTION=ssl

# Legacy names (still supported):
# SMTP_HOST=smtp.zohocloud.ca
# SMTP_PORT=465
# SMTP_USERNAME=contact@ruizerwin.com
# SMTP_PASSWORD=
# SMTP_ENCRYPTION=ssl


# *****************************************************************************
# OUTGOING MAIL IDENTITY (what recipients see as sender)
# *****************************************************************************

# From email — must match ZOHO_SMTP_USER
MAIL_FROM_ADDRESS=contact@ruizerwin.com

# From name — use quotes if the name contains spaces
MAIL_FROM_NAME=ruizerwin

# Legacy names (still supported):
# SMTP_FROM_EMAIL=contact@ruizerwin.com
# SMTP_FROM_NAME=ruizerwin


# *****************************************************************************
# CONTACT FORM INBOX (where messages are delivered)
# *****************************************************************************

# Deliver to your Zoho mailbox (recommended). Forward to Gmail in Zoho Mail settings.
MAIL_INBOX_ADDRESS=contact@ruizerwin.com

# Display name for inbox — MUST use quotes (name has a space!)
MAIL_INBOX_NAME="Erwin Padilla"

# Legacy names (still supported):
# CONTACT_TO_EMAIL=ruizerwin1@gmail.com
# CONTACT_TO_NAME="Erwin Padilla"
