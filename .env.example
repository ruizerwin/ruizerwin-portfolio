# ============================================================
# LOCAL development template (safe to commit)
# Copy to .env and fill values. Never commit .env.
# Domain folder can stay ruizerwin.com — APP_NAME is ruizerwin.
# ============================================================

APP_NAME=ruizerwin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ruizerwin.com.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@ruizerwin.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_INBOX_ADDRESS=
MAIL_INBOX_NAME="Erwin Padilla"

# Optional locally — leave empty to disable reCAPTCHA in local
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
