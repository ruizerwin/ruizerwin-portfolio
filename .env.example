# ============================================================
# ruizerwin.com — environment example (safe to commit)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# local | development | production
APP_ENV=local
APP_NAME=ruizerwin
APP_URL=http://ruizerwin.com.test

# Preferred reCAPTCHA v3 keys
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

# Legacy aliases still supported by boot.php
# CONTACT_RECAPTCHA_SITE_KEY=
# CONTACT_RECAPTCHA_SECRET_KEY=

# Preferred Zoho SMTP settings
ZOHO_SMTP_HOST=smtp.zohocloud.ca
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=contact@ruizerwin.com
ZOHO_APP_PASSWORD=
ZOHO_SMTP_ENCRYPTION=ssl

# Legacy aliases still supported by boot.php
# SMTP_HOST=smtp.zohocloud.ca
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=contact@ruizerwin.com
# SMTP_FROM_NAME=ruizerwin

MAIL_FROM_ADDRESS=contact@ruizerwin.com
MAIL_FROM_NAME=ruizerwin
MAIL_INBOX_ADDRESS=
MAIL_INBOX_NAME=Erwin Padilla

# Legacy aliases still supported by boot.php
# CONTACT_TO_EMAIL=
# CONTACT_TO_NAME=Erwin Padilla
